#!/usr/bin/env python3
"""wb-pc-console -- talk to a Wiren Board console kept by wb-pc-consoled.

The daemon owns the tty; this tool only touches the daemon's files and
FIFOs, so it can never steal or wedge the port.

Commands:
  list                                devices + running instances
  status INST                         daemon status.json + service state
  files INST                          print per-instance file paths
  send INST [TEXT...]                 send TEXT + newline (-n: no newline;
                                      no TEXT: read stdin)
  raw INST STRING                     send STRING with \\n \\r \\t \\e \\xNN escapes, no newline added
  key INST KEY [KEY...]               named keys: enter tab esc space backspace up down
                                      left right home end pgup pgdn delete f1-f4 ctrl-<x> sysrq-<x>
  run INST TEXT [--expect RE] [--timeout S] [-n]   send TEXT + newline (-n: none),
                                      print console output that follows; with
                                      --expect exit 0 once RE matches
  expect INST RE [--timeout S]        wait for RE in new ts.log lines, print match
  reset INST [--no-wait] [--timeout S]  USB-reset the console adapter and wait
                                      for the outcome event; exit 0 = reset done
  break INST                          send serial break
  reopen INST                         make daemon close+reopen the tty
  kick INST                           re-send the line coding (revives a mute
                                      Holtek console without a USB reset)
  mark INST TEXT...                   write a marker line into ts.log
  tail INST [--ts] [-n N]             tail -F the raw (or timestamped) log
  attach INST                         interactive session, exit with Ctrl-]

run/expect match against board output only: the daemon's own event lines
(=== wb-pc-console: ..., e.g. the TX echo) are skipped, so expecting a
token that appears in the sent command cannot false-match.
"""

import argparse
import glob
import json
import os
import re
import select
import subprocess
import sys
import time

BASE = os.path.expanduser(os.environ.get("WB_PC_CONSOLE_BASE_DIR", "~/wb-pc-console"))


def paths(inst):
    d = os.path.join(BASE, inst)
    return {
        "dir": d,
        "raw": os.path.join(d, "raw.log"),
        "ts": os.path.join(d, "ts.log"),
        "in": os.path.join(d, "in"),
        "ctl": os.path.join(d, "ctl"),
        "status": os.path.join(d, "status.json"),
    }


def die(msg, rc=2):
    sys.stderr.write("wb-pc-console: %s\n" % msg)
    sys.exit(rc)


def fifo_write(path, data):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
    except FileNotFoundError:
        die("%s does not exist -- daemon never started? "
            "(systemctl --user status 'wb-pc-console@*')" % path)
    except OSError as e:
        die("cannot open %s: %s (daemon not running?)" % (path, e))
    try:
        off = 0
        while off < len(data):
            try:
                off += os.write(fd, data[off:])
            except BlockingIOError:
                time.sleep(0.01)
    finally:
        os.close(fd)


def unescape(s):
    out = bytearray()
    simple = {"n": 10, "r": 13, "t": 9, "0": 0, "a": 7, "b": 8,
              "f": 12, "v": 11, "e": 27, "\\": 92}
    i = 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            n = s[i + 1]
            if n in simple:
                out.append(simple[n])
                i += 2
                continue
            if n == "x" and i + 3 < len(s):
                try:
                    out.append(int(s[i + 2:i + 4], 16))
                    i += 4
                    continue
                except ValueError:
                    pass
        out.extend(c.encode("utf-8"))
        i += 1
    return bytes(out)


KEYS = {
    "enter": b"\r", "lf": b"\n", "crlf": b"\r\n", "tab": b"\t", "esc": b"\x1b",
    "space": b" ", "backspace": b"\x7f",
    "up": b"\x1b[A", "down": b"\x1b[B", "right": b"\x1b[C", "left": b"\x1b[D",
    "home": b"\x1b[H", "end": b"\x1b[F", "pgup": b"\x1b[5~", "pgdn": b"\x1b[6~",
    "delete": b"\x1b[3~",
    "f1": b"\x1bOP", "f2": b"\x1bOQ", "f3": b"\x1bOR", "f4": b"\x1bOS",
}


def key_bytes(name):
    k = name.lower()
    if k in KEYS:
        return KEYS[k]
    if k.startswith("ctrl-") and len(k) == 6:
        ch = k[5]
        if "a" <= ch <= "z":
            return bytes([ord(ch) - 96])
        specials = {"[": 27, "\\": 28, "]": 29, "^": 30, "_": 31, "@": 0}
        if ch in specials:
            return bytes([specials[ch]])
    return None


def follow_lines(path, offset, deadline):
    """Yield complete lines appended to path, rotation/truncation aware."""
    f = None
    buf = ""
    pos = offset
    while time.monotonic() < deadline:
        if f is None:
            try:
                f = open(path, "r", errors="replace")
                f.seek(pos)
            except (FileNotFoundError, OSError):
                time.sleep(0.1)
                continue
        chunk = f.read(65536)
        if chunk:
            buf += chunk
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                yield line
            continue
        try:
            st = os.stat(path)
            if (st.st_ino != os.fstat(f.fileno()).st_ino
                    or st.st_size < f.tell()):
                f.close()
                f = None
                pos = 0
                continue
        except FileNotFoundError:
            f.close()
            f = None
            pos = 0
        time.sleep(0.05)


def ts_size(p):
    try:
        return os.path.getsize(p["ts"])
    except OSError:
        return 0


# daemon-generated event lines in ts.log (incl. the TX echo of what we just
# sent); run/expect must never treat these as board output
EVENT_RE = re.compile(r"^\[[^\]]*\] === wb-pc-console: ")


# ---------------- commands ----------------

def cmd_list(args):
    print("devices (/dev/serial/by-id):")
    for p in sorted(glob.glob("/dev/serial/by-id/*")):
        print("  %s -> %s" % (p, os.path.realpath(p)))
    print("instances (%s):" % BASE)
    if os.path.isdir(BASE):
        for inst in sorted(os.listdir(BASE)):
            sp = os.path.join(BASE, inst, "status.json")
            if not os.path.exists(sp):
                continue
            try:
                st = json.load(open(sp))
            except (OSError, ValueError):
                print("  %-12s status.json unreadable" % inst)
                continue
            alive = False
            try:
                os.kill(st.get("pid", 0), 0)
                alive = True
            except OSError:
                pass
            print("  %-12s daemon=%s connected=%s tty=%s rx=%dB kills=%d"
                  % (inst, "up" if alive else "DOWN",
                     st.get("connected"), st.get("tty"),
                     st.get("rx_bytes", 0), st.get("intruders_killed", 0)))
    return 0


def cmd_files(args):
    for k, v in paths(args.instance).items():
        print("%-7s %s" % (k, v))
    return 0


def cmd_status(args):
    p = paths(args.instance)
    try:
        print(open(p["status"]).read())
    except OSError as e:
        die("no status: %s" % e)
    r = subprocess.run(["systemctl", "--user", "is-active",
                        "wb-pc-console@%s" % args.instance],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    print("service: %s" % r.stdout.decode().strip())
    return 0


def cmd_send(args):
    p = paths(args.instance)
    if args.text:
        data = " ".join(args.text).encode("utf-8")
    else:
        data = sys.stdin.buffer.read()
    if not args.no_newline:
        data += b"\n"
    fifo_write(p["in"], data)
    return 0


def cmd_raw(args):
    fifo_write(paths(args.instance)["in"], unescape(args.string))
    return 0


def cmd_key(args):
    p = paths(args.instance)
    for name in args.keys:
        k = name.lower()
        if k.startswith("sysrq-") and len(k) == 7:
            # magic sysrq over serial: break, then the key
            fifo_write(p["ctl"], b"break\n")
            time.sleep(0.2)
            fifo_write(p["in"], k[6].encode())
            continue
        b = key_bytes(name)
        if b is None:
            die("unknown key %r" % name)
        fifo_write(p["in"], b)
        time.sleep(0.05)
    return 0


def cmd_ctl_factory(line):
    def cmd(args):
        text = line
        if getattr(args, "text", None):
            text += " " + " ".join(args.text)
        fifo_write(paths(args.instance)["ctl"], text.encode() + b"\n")
        return 0
    return cmd


def reset_outcome(line):
    """0 = reset done, 1 = failed/refused, None = not an outcome event
    (the daemon also echoes the request token into progress events such
    as 'port closed: usb reset (...)' -- those must be waited past)."""
    if "usb reset done" in line:
        return 0
    if "usb reset FAILED" in line or "usb reset refused" in line:
        return 1
    return None


def cmd_reset(args):
    """Request a USB reset and report the actual outcome via the exit code.

    The ts.log offset is recorded BEFORE the ctl write and the request
    carries a unique token that the daemon echoes into its outcome event,
    so even an instantly-completing reset cannot be missed."""
    p = paths(args.instance)
    token = "req:%d.%d" % (os.getpid(), int(time.time() * 1000) % 1000000)
    start = ts_size(p)
    fifo_write(p["ctl"], ("reset wb-pc-console [%s]\n" % token).encode())
    if args.no_wait:
        return 0
    deadline = time.monotonic() + args.timeout
    for line in follow_lines(p["ts"], start, deadline):
        if token not in line:
            continue
        rc = reset_outcome(line)
        if rc is not None:
            print(line)
            return rc
    sys.stderr.write("wb-pc-console: no reset outcome within %.0fs "
                     "(daemon not running?)\n" % args.timeout)
    return 1


def cmd_expect(args):
    p = paths(args.instance)
    start = ts_size(p)
    deadline = time.monotonic() + args.timeout
    pat = re.compile(args.regex)
    for line in follow_lines(p["ts"], start, deadline):
        if EVENT_RE.match(line):
            continue
        if pat.search(line):
            print(line)
            return 0
    sys.stderr.write("wb-pc-console: timeout (%.0fs) waiting for /%s/\n"
                     % (args.timeout, args.regex))
    return 1


def cmd_run(args):
    p = paths(args.instance)
    start = ts_size(p)
    timeout = args.timeout if args.timeout is not None else (30 if args.expect else 3)
    data = args.text.encode("utf-8")
    if not args.no_newline:
        data += b"\n"
    fifo_write(p["in"], data)
    deadline = time.monotonic() + timeout
    pat = re.compile(args.expect) if args.expect else None
    matched = False
    for line in follow_lines(p["ts"], start, deadline):
        print(line)
        if pat and not EVENT_RE.match(line) and pat.search(line):
            matched = True
            break
    if pat and not matched:
        sys.stderr.write("wb-pc-console: timeout (%.0fs) waiting for /%s/\n"
                         % (timeout, args.expect))
        return 1
    return 0


def cmd_tail(args):
    p = paths(args.instance)
    path = p["ts"] if args.ts else p["raw"]
    os.execvp("tail", ["tail", "-n", str(args.lines), "-F", path])


def cmd_attach(args):
    import termios
    import tty
    p = paths(args.instance)
    if not os.path.exists(p["in"]):
        die("%s missing -- daemon not running?" % p["in"])
    sys.stderr.write("[attached to %s; exit: Ctrl-]]\n" % args.instance)
    proc = subprocess.Popen(["tail", "-n", "30", "-F", p["raw"]])
    fdin = sys.stdin.fileno()
    save = termios.tcgetattr(fdin)
    try:
        tty.setraw(fdin)
        while True:
            r, _, _ = select.select([fdin], [], [])
            data = os.read(fdin, 1024)
            if not data or b"\x1d" in data:  # Ctrl-]
                break
            fifo_write(p["in"], data)
    finally:
        termios.tcsetattr(fdin, termios.TCSADRAIN, save)
        proc.terminate()
        sys.stderr.write("\n[detached]\n")
    return 0


def main():
    ap = argparse.ArgumentParser(
        prog="wb-pc-console",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(fn=cmd_list)

    def with_inst(name, **kw):
        sp = sub.add_parser(name, **kw)
        sp.add_argument("instance")
        return sp

    with_inst("files").set_defaults(fn=cmd_files)
    with_inst("status").set_defaults(fn=cmd_status)

    sp = with_inst("send")
    sp.add_argument("text", nargs="*")
    sp.add_argument("-n", "--no-newline", action="store_true")
    sp.set_defaults(fn=cmd_send)

    sp = with_inst("raw")
    sp.add_argument("string")
    sp.set_defaults(fn=cmd_raw)

    sp = with_inst("key")
    sp.add_argument("keys", nargs="+")
    sp.set_defaults(fn=cmd_key)

    sp = with_inst("run")
    sp.add_argument("text")
    sp.add_argument("--expect", metavar="RE")
    sp.add_argument("--timeout", type=float)
    sp.add_argument("-n", "--no-newline", action="store_true")
    sp.set_defaults(fn=cmd_run)

    sp = with_inst("expect")
    sp.add_argument("regex")
    sp.add_argument("--timeout", type=float, default=30)
    sp.set_defaults(fn=cmd_expect)

    sp = with_inst("reset")
    sp.add_argument("--no-wait", action="store_true",
                    help="fire and forget, do not wait for the outcome event")
    sp.add_argument("--timeout", type=float, default=20)
    sp.set_defaults(fn=cmd_reset)

    with_inst("break").set_defaults(fn=cmd_ctl_factory("break"))
    with_inst("reopen").set_defaults(fn=cmd_ctl_factory("reopen"))
    with_inst("kick").set_defaults(fn=cmd_ctl_factory("kick"))

    sp = with_inst("mark")
    sp.add_argument("text", nargs="+")
    sp.set_defaults(fn=cmd_ctl_factory("mark"))

    sp = with_inst("tail")
    sp.add_argument("--ts", action="store_true", help="tail ts.log instead of raw.log")
    sp.add_argument("-n", "--lines", type=int, default=50)
    sp.set_defaults(fn=cmd_tail)

    with_inst("attach").set_defaults(fn=cmd_attach)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
