#!/usr/bin/env python3
"""wb-pc-consoled -- exclusive keeper of one Wiren Board USB debug console.

Usage:  wb-pc-consoled <SERIAL>                          e.g.  wb-pc-consoled ALEPBSP3
        wb-pc-consoled --usb-reset /dev/bus/usb/BBB/DDD  (internal helper)

What it does:
  * finds the port via /dev/serial/by-id/*<SERIAL>*-if00 -- stable across
    /dev/ttyACMn renumbering; reopens automatically when the device
    disappears and comes back;
  * holds the port exclusively (TIOCEXCL): any other non-root open() gets
    EBUSY instead of stealing bytes;
  * SIGKILLs any other process found holding the port (fuser sweep every
    WB_PC_CONSOLE_KILL_INTERVAL seconds and right before every open;
    each PID is re-verified against /proc/<pid>/fd just before the kill);
  * appends every received byte verbatim to <dir>/raw.log and stamped
    lines to <dir>/ts.log:  "[YYYY-mm-ddTHH:MM:SS.<9-digit ns>+ZZZZ] line"
    (stamp taken when the first byte of the line arrived; partial lines
    are flushed after WB_PC_CONSOLE_FLUSH_TIMEOUT so prompts show up);
  * forwards bytes written into the FIFO <dir>/in to the port (queued
    while the port is down -- up to 256 KiB -- delivered after reopen);
  * executes commands written into the FIFO <dir>/ctl, one per line:
        reset [why]   -- USB reset of the underlying USB device
        break         -- send serial break
        reopen        -- close and reopen the tty
        mark <text>   -- write a marker line into ts.log
        flush         -- flush a pending partial line to ts.log
  * maintains <dir>/status.json (atomically replaced).

<dir> = $WB_PC_CONSOLE_BASE_DIR/<SERIAL>, default ~/wb-pc-console/<SERIAL>.
The instance directory is chmod 0700 and its files 0600: the FIFOs drive
what is usually a root console on the board, and ts.log records sent
bytes (see WB_PC_CONSOLE_LOG_TX below).

Environment knobs (all optional):
  WB_PC_CONSOLE_BASE_DIR        base directory            (~/wb-pc-console)
  WB_PC_CONSOLE_GLOB            device glob override      (/dev/serial/by-id/*<SERIAL>*-if00)
  WB_PC_CONSOLE_BAUD            baud rate                 (115200)
  WB_PC_CONSOLE_KILL_INTERVAL   intruder sweep period, s  (1.0)
  WB_PC_CONSOLE_WRITE_DELAY_MS  per-byte TX pacing, ms    (0 = off)
  WB_PC_CONSOLE_FLUSH_TIMEOUT   partial-line flush, s     (1.0)
  WB_PC_CONSOLE_MAX_BYTES       rotate log when bigger    (536870912; 0 = never)
  WB_PC_CONSOLE_ROTATE_KEEP     rotated generations kept  (3)
  WB_PC_CONSOLE_RESET_COOLDOWN  min seconds between AUTOMATIC USB resets
                                (30); manual ctl resets are never throttled
  WB_PC_CONSOLE_LOG_TX          log TX chunks as ts.log events (1)
                                NOTE: this records input the console does
                                not echo back -- including passwords typed
                                at login:/sudo prompts

There is deliberately no idle-based auto reset: a silent console is
normal. Automatic USB reset fires only on bursts of I/O errors while the
device is still enumerated (the detectable wedge signature). For an
idle-watchdog policy, watch last_rx_age_s in status.json and write
"reset idle" into the ctl FIFO from outside.
"""

import errno
import fcntl
import glob
import json
import os
import re
import select
import signal
import stat
import subprocess
import sys
import termios
import time
import traceback

USBDEVFS_RESET = 0x5514  # _IO('U', 20); stdlib has no constant for it
USBFS_NODE_RE = re.compile(r"/dev/bus/usb/\d{3}/\d{3}")

TX_CAP = 256 * 1024   # max bytes queued for the port
CTL_CAP = 4096        # max ctl bytes buffered without a newline
FUSER_TIMEOUT = 0.5   # keep the sweep from stalling the RX loop


def envs(name, default):
    return os.environ.get(name, default)


def envf(name, default):
    try:
        return float(os.environ[name])
    except (KeyError, ValueError):
        return default


def fmt_ns(ns):
    sec, frac = divmod(ns, 1_000_000_000)
    lt = time.localtime(sec)
    return "%s.%09d%s" % (time.strftime("%Y-%m-%dT%H:%M:%S", lt), frac,
                          time.strftime("%z", lt))


def drain(fd):
    """Non-blocking best-effort read of a FIFO."""
    try:
        return os.read(fd, 65536)
    except (BlockingIOError, OSError):
        return b""


class Keeper:
    def __init__(self, instance):
        self.inst = instance
        self.base = os.path.expanduser(envs("WB_PC_CONSOLE_BASE_DIR", "~/wb-pc-console"))
        self.dir = os.path.join(self.base, instance)
        self.pattern = envs("WB_PC_CONSOLE_GLOB",
                            "/dev/serial/by-id/*%s*-if00" % instance)
        self.baud = int(envf("WB_PC_CONSOLE_BAUD", 115200))
        self.kill_interval = envf("WB_PC_CONSOLE_KILL_INTERVAL", 1.0)
        self.write_delay = envf("WB_PC_CONSOLE_WRITE_DELAY_MS", 0.0) / 1000.0
        self.flush_timeout = envf("WB_PC_CONSOLE_FLUSH_TIMEOUT", 1.0)
        self.max_bytes = int(envf("WB_PC_CONSOLE_MAX_BYTES", 512 * 1024 * 1024))
        self.keep = max(1, int(envf("WB_PC_CONSOLE_ROTATE_KEEP", 3)))
        self.reset_cooldown = envf("WB_PC_CONSOLE_RESET_COOLDOWN", 30.0)
        self.log_tx = envf("WB_PC_CONSOLE_LOG_TX", 1.0) != 0

        self.raw_path = os.path.join(self.dir, "raw.log")
        self.ts_path = os.path.join(self.dir, "ts.log")
        self.in_path = os.path.join(self.dir, "in")
        self.ctl_path = os.path.join(self.dir, "ctl")
        self.status_path = os.path.join(self.dir, "status.json")

        self.ser_fd = None
        self.byid = None
        self.real = None
        self.last_tty = None       # last tty we held, for status display only
        self.raw_fd = None
        self.ts_f = None
        self.tx = bytearray()
        self.last_tx = 0.0
        self.partial = bytearray()
        self.partial_ns = 0
        self.partial_mono = 0.0
        self.rx_total = 0
        self.tx_total = 0
        self.tx_dropped = 0
        self.raw_dropped = 0       # bytes lost to raw.log write failures
        self.ts_dropped = 0        # ts.log lines lost to write failures
        self.kills = 0
        self.last_kill = None
        self.last_rx_mono = None
        self.last_reset_mono = None
        self.last_reset_ns = None
        self.started_ns = time.time_ns()
        self.io_errors = []        # monotonic times of recent read/open I/O errors
        self.fuser_ok = True       # flips off permanently if fuser is missing
        self.last_sweep = 0.0
        self.last_status = 0.0
        self.last_open_err = ""
        self.waiting_logged = False
        self.multi_warned = False
        self.ctl_buf = b""
        self._rate = {}            # per-key rate limiting for noisy logs
        self.running = True

    # ---------------- logging ----------------

    def log(self, msg):
        # journald can restart and break the stream socket; never die on stderr
        try:
            sys.stderr.write(msg + "\n")
            sys.stderr.flush()
        except OSError:
            pass

    def log_rate(self, key, msg, period=5.0):
        now = time.monotonic()
        if now - self._rate.get(key, -period) >= period:
            self._rate[key] = now
            self.log(msg)

    def _ts_write(self, text):
        """Write to ts.log without ever crashing the daemon on I/O errors."""
        if self.ts_f is None:
            self.ts_dropped += 1
            return
        try:
            self.ts_f.write(text)
        except (OSError, ValueError) as e:
            self.ts_dropped += 1
            self.log_rate("ts-io", "ts.log write failed: %s (will retry reopen)" % e)
            try:
                self.ts_f.close()
            except (OSError, ValueError):
                pass
            self.ts_f = None

    def _raw_write(self, data):
        """Append to raw.log; count what could not be written, never raise."""
        if self.raw_fd is None:
            self.raw_dropped += len(data)
            return
        off = 0
        while off < len(data):
            try:
                off += os.write(self.raw_fd, data[off:])
            except InterruptedError:
                continue
            except OSError as e:
                self.raw_dropped += len(data) - off
                self.log_rate("raw-io", "raw.log write failed: %s" % e)
                if e.errno not in (errno.ENOSPC, errno.EDQUOT):
                    # fd is likely unusable (EBADF/EIO); drop it, reopen later
                    try:
                        os.close(self.raw_fd)
                    except OSError:
                        pass
                    self.raw_fd = None
                return

    def _maybe_reopen_logs(self):
        if self.raw_fd is None:
            try:
                self.raw_fd = os.open(self.raw_path,
                                      os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
                self.log("raw.log reopened")
            except OSError:
                pass
        if self.ts_f is None:
            try:
                self.ts_f = open(self.ts_path, "a", buffering=1, errors="replace")
                self.log("ts.log reopened")
            except OSError:
                pass

    def event(self, msg):
        self._ts_write("[%s] === wb-pc-console: %s\n" % (fmt_ns(time.time_ns()), msg))
        self.log(msg)

    # ---------------- setup ----------------

    def setup(self):
        # the FIFOs drive a (usually root) console and ts.log may record
        # non-echoed input -- keep the whole instance dir owner-only
        os.umask(0o077)
        os.makedirs(self.dir, mode=0o700, exist_ok=True)
        os.chmod(self.dir, 0o700)
        self.lock_fd = os.open(os.path.join(self.dir, "lock"),
                               os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.log("another wb-pc-consoled already keeps %s (lock busy), exiting" % self.dir)
            sys.exit(1)
        for p in (self.in_path, self.ctl_path):
            try:
                if not stat.S_ISFIFO(os.stat(p).st_mode):
                    os.remove(p)
                    os.mkfifo(p, 0o600)
            except FileNotFoundError:
                os.mkfifo(p, 0o600)
            os.chmod(p, 0o600)  # mkfifo mode is umask-masked; enforce explicitly
        self.raw_fd = os.open(self.raw_path,
                              os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        self.ts_f = open(self.ts_path, "a", buffering=1, errors="replace")
        for p in (self.raw_path, self.ts_path, self.status_path):
            try:
                os.chmod(p, 0o600)  # tighten files left by earlier versions
            except OSError:
                pass
        # O_RDWR on the FIFOs: never blocks, never sees EOF when writers leave
        self.in_fd = os.open(self.in_path, os.O_RDWR | os.O_NONBLOCK)
        self.ctl_fd = os.open(self.ctl_path, os.O_RDWR | os.O_NONBLOCK)
        signal.signal(signal.SIGTERM, self._sig)
        signal.signal(signal.SIGINT, self._sig)
        self.event("daemon started: pid=%d pattern=%s baud=%d dir=%s"
                   % (os.getpid(), self.pattern, self.baud, self.dir))

    def _sig(self, signum, frame):
        self.running = False

    # ---------------- intruder control ----------------

    def _pid_holds(self, pid, rdev):
        """True/False: does pid hold the device?  None: cannot tell (other uid)."""
        fddir = "/proc/%d/fd" % pid
        try:
            fds = os.listdir(fddir)
        except PermissionError:
            return None
        except OSError:
            return False
        for fd in fds:
            try:
                if os.stat(os.path.join(fddir, fd)).st_rdev == rdev:
                    return True
            except OSError:
                continue
        return False

    def port_users(self, real):
        """PIDs (excluding self) that look like they hold the tty."""
        me = os.getpid()
        if self.fuser_ok:
            try:
                p = subprocess.run(["fuser", real], stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, timeout=FUSER_TIMEOUT)
                pids = {int(x) for x in re.findall(rb"\d+", p.stdout)}
                return sorted(x for x in pids if x != me)
            except FileNotFoundError:
                self.fuser_ok = False
                self.log("fuser not found; using /proc scan instead")
            except subprocess.TimeoutExpired:
                # never let a stuck fuser stall the RX loop; skip this round
                self.log_rate("fuser-to", "fuser took >%.1fs; sweep skipped" % FUSER_TIMEOUT)
                return []
            except OSError as e:
                self.log_rate("fuser-err", "fuser failed: %s" % e)
                return []
        try:
            rdev = os.stat(real).st_rdev
        except OSError:
            return []
        pids = []
        for d in os.listdir("/proc"):
            if d.isdigit() and int(d) != me and self._pid_holds(int(d), rdev):
                pids.append(int(d))
        return sorted(pids)

    def sweep(self, real=None):
        real = real or self.real
        if not real:
            return
        try:
            rdev = os.stat(real).st_rdev
        except OSError:
            return
        for pid in self.port_users(real):
            # re-verify right before the kill: fuser's snapshot is stale by
            # now and the PID could have been recycled to an innocent process
            holds = self._pid_holds(pid, rdev)
            if holds is None:
                self.log_rate("uid-%d" % pid,
                              "intruder pid %d on %s: other uid, cannot verify/kill"
                              % (pid, real), period=30.0)
                continue
            if not holds:
                continue
            name = "?"
            try:
                with open("/proc/%d/cmdline" % pid, "rb") as f:
                    name = (f.read().replace(b"\0", b" ")
                            .decode("utf-8", "replace").strip()[:120]) or "?"
            except OSError:
                pass
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                continue
            except PermissionError:
                self.event("intruder pid %d (%s) on %s: cannot kill (other uid)"
                           % (pid, name, real))
                continue
            self.kills += 1
            self.last_kill = "pid %d (%s)" % (pid, name)
            self.event("SIGKILLed intruder pid %d (%s) on %s" % (pid, name, real))

    # ---------------- port ----------------

    def open_port(self):
        matches = sorted(glob.glob(self.pattern))
        if not matches:
            if not self.waiting_logged:
                self.event("waiting for device %s" % self.pattern)
                self.waiting_logged = True
            return
        byid = matches[0]
        if len(matches) > 1 and not self.multi_warned:
            self.event("warning: %d matches for %s, using %s"
                       % (len(matches), self.pattern, byid))
            self.multi_warned = True
        real = os.path.realpath(byid)
        now = time.monotonic()
        if now - self.last_sweep >= self.kill_interval:
            self.last_sweep = now
            self.sweep(real)
        try:
            fd = os.open(real, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        except OSError as e:
            self.open_failed(real, e)
            return
        try:
            fcntl.ioctl(fd, termios.TIOCEXCL)
            spd = getattr(termios, "B%d" % self.baud, None)
            if spd is None:
                raise ValueError("unsupported baud %d" % self.baud)
            attrs = termios.tcgetattr(fd)
            attrs[0] = 0                                             # iflag: fully raw
            attrs[1] = 0                                             # oflag
            attrs[2] = termios.CREAD | termios.CLOCAL | termios.CS8  # no HUPCL: reopen w/o DTR glitch
            attrs[3] = 0                                             # lflag
            attrs[4] = spd
            attrs[5] = spd
            attrs[6][termios.VMIN] = 0
            attrs[6][termios.VTIME] = 0
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
        except (OSError, termios.error, ValueError) as e:
            os.close(fd)
            self.open_failed(real, e)
            return
        self.ser_fd = fd
        self.byid = byid
        self.real = real
        self.last_tty = real
        self.waiting_logged = False
        self.last_open_err = ""
        self.last_rx_mono = time.monotonic()
        self.event("port opened: %s -> %s @ %d 8N1 (exclusive)"
                   % (byid, real, self.baud))
        self.write_status(force=True)

    def open_failed(self, real, e):
        msg = "open %s failed: %s" % (real, e)
        if msg != self.last_open_err:
            self.event(msg)
            self.last_open_err = msg
        if isinstance(e, OSError) and e.errno in (errno.EIO, errno.EPROTO,
                                                  errno.ENODEV, errno.ENXIO):
            self.note_io_error()

    def close_port(self, reason):
        if self.ser_fd is None:
            return
        try:
            os.close(self.ser_fd)
        except OSError:
            pass
        self.ser_fd = None
        # a stale device path must never be reused (e.g. as a USB reset
        # target after renumbering) -- keep only a display copy
        self.last_tty = self.real
        self.real = None
        self.byid = None
        self.event("port closed: %s" % reason)
        self.write_status(force=True)

    def reset_allowed(self, now):
        return (self.last_reset_mono is None
                or now - self.last_reset_mono >= self.reset_cooldown)

    def note_io_error(self):
        """Auto-USB-reset when I/O errors repeat while the device is still
        enumerated -- that is the detectable 'wedged CDC-ACM' signature."""
        now = time.monotonic()
        self.io_errors = [t for t in self.io_errors if now - t < 10.0] + [now]
        if len(self.io_errors) >= 3 and glob.glob(self.pattern):
            if self.reset_allowed(now):
                self.io_errors = []
                self.usb_reset("auto: repeated I/O errors while device present")

    # ---------------- USB reset ----------------

    def usb_reset(self, reason):
        # resolve the target strictly from the currently held tty or a fresh
        # by-id lookup: after renumbering, a remembered /dev/ttyACMn path may
        # belong to a DIFFERENT device, and resetting the neighbor is worse
        # than failing loudly
        if self.ser_fd is not None:
            real = self.real
        else:
            m = sorted(glob.glob(self.pattern))
            if not m:
                self.event("usb reset refused: no device matches %s (%s)"
                           % (self.pattern, reason))
                return False
            real = os.path.realpath(m[0])
        tty_name = os.path.basename(real)
        try:
            ifdir = os.path.realpath("/sys/class/tty/%s/device" % tty_name)
            usbdir = os.path.dirname(ifdir)
            with open(os.path.join(usbdir, "busnum")) as f:
                bus = int(f.read())
            with open(os.path.join(usbdir, "devnum")) as f:
                dev = int(f.read())
        except (OSError, ValueError) as e:
            self.event("usb reset FAILED: cannot resolve usb device of %s: %s (%s)"
                       % (tty_name, e, reason))
            return False
        node = "/dev/bus/usb/%03d/%03d" % (bus, dev)
        self.close_port("usb reset (%s)" % reason)
        self.last_reset_mono = time.monotonic()
        self.last_reset_ns = time.time_ns()
        try:
            fd = os.open(node, os.O_WRONLY)
            try:
                fcntl.ioctl(fd, USBDEVFS_RESET, 0)
            finally:
                os.close(fd)
            self.event("usb reset done: %s (%s)" % (node, reason))
            self.write_status(force=True)
            return True
        except OSError as e:
            if e.errno in (errno.EACCES, errno.EPERM):
                try:
                    r = subprocess.run(
                        ["sudo", "-n", sys.executable,
                         os.path.realpath(__file__), "--usb-reset", node],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        timeout=10)
                    if r.returncode == 0:
                        self.event("usb reset done via sudo: %s (%s)" % (node, reason))
                        return True
                except (OSError, subprocess.TimeoutExpired):
                    pass
                self.event("usb reset FAILED: no write access to %s and no "
                           "passwordless sudo -- see README 'USB reset "
                           "permissions' (%s)" % (node, reason))
            else:
                self.event("usb reset FAILED on %s: %s (%s)" % (node, e, reason))
            return False

    # ---------------- RX path ----------------

    def feed(self, data, ns, mono):
        self._raw_write(data)
        self.rx_total += len(data)
        self.last_rx_mono = mono
        start = 0
        while True:
            idx = data.find(b"\n", start)
            if idx == -1:
                rest = data[start:]
                if rest:
                    if not self.partial:
                        self.partial_ns = ns
                        self.partial_mono = mono
                    self.partial += rest
                break
            line_ns = self.partial_ns if self.partial else ns
            line = bytes(self.partial) + data[start:idx]
            self.partial.clear()
            self.emit(line_ns, line)
            start = idx + 1

    def emit(self, ns, bline):
        text = bline.decode("utf-8", "replace").rstrip("\r")
        self._ts_write("[%s] %s\n" % (fmt_ns(ns), text))

    def flush_partial(self):
        if self.partial:
            self.emit(self.partial_ns, bytes(self.partial))
            self.partial.clear()

    # ---------------- TX path ----------------

    def handle_input(self, data):
        if len(self.tx) + len(data) > TX_CAP:
            self.tx_dropped += len(data)
            self.event("input dropped: tx queue full (%dB queued, %dB dropped total)"
                       % (len(self.tx), self.tx_dropped))
            return
        if self.ser_fd is None and not self.tx:
            self.event("input while port closed, queueing %d bytes" % len(data))
        self.tx += data
        if self.log_tx:
            self.event("TX %dB: %s" % (len(data), repr(data)[:160]))

    def pump_tx(self, now):
        if not self.tx or self.ser_fd is None:
            return
        if self.write_delay > 0:
            if now - self.last_tx < self.write_delay:
                return
            chunk = bytes(self.tx[:1])
        else:
            chunk = bytes(self.tx)
        try:
            n = os.write(self.ser_fd, chunk)
        except BlockingIOError:
            return
        except OSError as e:
            self.event("write error: %s" % e)
            self.close_port("write error")
            self.note_io_error()
            return
        del self.tx[:n]
        self.tx_total += n
        self.last_tx = now

    # ---------------- ctl commands ----------------

    def handle_ctl(self, data):
        self.ctl_buf += data
        if len(self.ctl_buf) > CTL_CAP and b"\n" not in self.ctl_buf:
            self.event("ctl buffer overflow (%dB without newline), discarded"
                       % len(self.ctl_buf))
            self.ctl_buf = b""
            return
        while b"\n" in self.ctl_buf:
            line, self.ctl_buf = self.ctl_buf.split(b"\n", 1)
            cmd = line.decode("utf-8", "replace").strip()
            if not cmd:
                continue
            word, _, rest = cmd.partition(" ")
            word = word.lower()
            if word == "reset":
                self.usb_reset(rest.strip() or "requested via ctl")
            elif word == "break":
                if self.ser_fd is not None:
                    try:
                        termios.tcsendbreak(self.ser_fd, 0)
                        self.event("serial break sent")
                    except (OSError, termios.error) as e:
                        self.event("break failed: %s" % e)
                else:
                    self.event("break: port not open")
            elif word == "reopen":
                self.close_port("reopen requested")
            elif word == "mark":
                self._ts_write("[%s] ==== MARK: %s\n"
                               % (fmt_ns(time.time_ns()), rest))
            elif word == "flush":
                self.flush_partial()
            else:
                self.event("unknown ctl command: %r" % cmd)

    # ---------------- housekeeping ----------------

    def write_status(self, force=False):
        now = time.monotonic()
        if not force and now - self.last_status < 2.0:
            return
        self.last_status = now
        self._maybe_reopen_logs()
        st = {
            "instance": self.inst,
            "pid": os.getpid(),
            "pattern": self.pattern,
            "device": self.byid,
            "tty": self.real or self.last_tty,
            "connected": self.ser_fd is not None,
            "baud": self.baud,
            "started_at": fmt_ns(self.started_ns),
            "rx_bytes": self.rx_total,
            "tx_bytes": self.tx_total,
            "tx_dropped_bytes": self.tx_dropped,
            "log_dropped": {"raw_bytes": self.raw_dropped, "ts_lines": self.ts_dropped},
            "last_rx_age_s": (round(now - self.last_rx_mono, 3)
                              if self.last_rx_mono is not None else None),
            "pending_tx_bytes": len(self.tx),
            "intruders_killed": self.kills,
            "last_kill": self.last_kill,
            "last_usb_reset_at": (fmt_ns(self.last_reset_ns)
                                  if self.last_reset_ns else None),
            "files": {"raw": self.raw_path, "ts": self.ts_path,
                      "in": self.in_path, "ctl": self.ctl_path},
        }
        tmp = self.status_path + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(st, f, indent=1)
            os.replace(tmp, self.status_path)
        except OSError:
            pass

    def _shift(self, path):
        for i in range(self.keep - 1, 0, -1):
            src = "%s.%d" % (path, i)
            if os.path.exists(src):
                os.replace(src, "%s.%d" % (path, i + 1))
        os.replace(path, path + ".1")

    def maybe_rotate(self):
        """Rotate crash-safely: only swap fds after the new file is open, so
        a failure (read-only fs, ENOSPC) leaves the old, still-valid fd in
        place and capture continues."""
        if self.max_bytes <= 0:
            return
        raw_big = False
        if self.raw_fd is not None:
            try:
                raw_big = os.fstat(self.raw_fd).st_size > self.max_bytes
            except OSError:
                pass
        if raw_big:
            try:
                self._shift(self.raw_path)
                new_fd = os.open(self.raw_path,
                                 os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            except OSError as e:
                self.log_rate("rot-raw", "raw.log rotation failed: %s" % e)
            else:
                try:
                    os.close(self.raw_fd)
                except OSError:
                    pass
                self.raw_fd = new_fd
                self.event("rotated raw.log")
        ts_big = False
        if self.ts_f is not None:
            try:
                ts_big = self.ts_f.tell() > self.max_bytes
            except (OSError, ValueError):
                pass
        if ts_big:
            try:
                self._shift(self.ts_path)
                new_f = open(self.ts_path, "a", buffering=1, errors="replace")
            except OSError as e:
                self.log_rate("rot-ts", "ts.log rotation failed: %s" % e)
            else:
                try:
                    self.ts_f.close()
                except (OSError, ValueError):
                    pass
                self.ts_f = new_f
                self.event("rotated ts.log")

    # ---------------- main loop ----------------

    def _tick(self):
        if self.ser_fd is None:
            self.open_port()
        rlist = [self.in_fd, self.ctl_fd]
        if self.ser_fd is not None:
            rlist.append(self.ser_fd)
        timeout = 0.05 if self.tx else 0.2
        try:
            r, _, _ = select.select(rlist, [], [], timeout)
        except InterruptedError:
            r = []
        now = time.monotonic()

        if self.ser_fd is not None and self.ser_fd in r:
            try:
                data = os.read(self.ser_fd, 65536)
            except BlockingIOError:
                data = None
            except OSError as e:
                self.event("read error: %s" % e)
                self.close_port("read error")
                self.note_io_error()
                data = None
            if data:
                self.feed(data, time.time_ns(), now)
            elif data == b"":
                self.event("hangup (EOF) on %s" % self.real)
                self.close_port("hangup")
                self.note_io_error()

        if self.in_fd in r:
            data = drain(self.in_fd)
            if data:
                self.handle_input(data)

        if self.ctl_fd in r:
            data = drain(self.ctl_fd)
            if data:
                self.handle_ctl(data)

        self.pump_tx(now)

        if self.partial and now - self.partial_mono > self.flush_timeout:
            self.flush_partial()

        if self.ser_fd is not None and now - self.last_sweep >= self.kill_interval:
            self.last_sweep = now
            self.sweep()

        self.maybe_rotate()
        self.write_status()

        if self.ser_fd is None:
            time.sleep(0.3)  # device absent or unopenable -- poll slowly

    def run(self):
        self.setup()
        while self.running:
            try:
                self._tick()
            except Exception:
                # a bug must not turn into a byte-eating crash/restart loop:
                # log it, keep the port open, keep going
                self.log_rate("tick-crash",
                              "unhandled error in main loop:\n%s"
                              % traceback.format_exc())
                time.sleep(0.1)
        self.flush_partial()
        self.event("daemon stopping (signal)")
        self.write_status(force=True)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "--usb-reset":
        node = os.path.realpath(sys.argv[2])
        if not USBFS_NODE_RE.fullmatch(node):
            sys.stderr.write("refusing to reset non-usbfs path: %s\n" % node)
            return 2
        fd = os.open(node, os.O_WRONLY)
        try:
            fcntl.ioctl(fd, USBDEVFS_RESET, 0)
        finally:
            os.close(fd)
        return 0
    if len(sys.argv) != 2 or sys.argv[1].startswith("-"):
        sys.stderr.write(__doc__)
        return 2
    Keeper(sys.argv[1]).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
